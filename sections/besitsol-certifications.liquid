{% comment %}
  BESITSOL Certifications Section — 认证展示
{% endcomment %}

<section id="s-certifications" class="besitsol-section besitsol-certs">
  <div class="besitsol-container">
    <div class="besitsol-certs__layout">
      <!-- Left Content -->
      <div class="besitsol-certs__content">
        <h2 class="besitsol-heading besitsol-certs__heading">{{ section.settings.heading }}</h2>
        <p class="besitsol-certs__subtitle">{{ section.settings.subtitle }}</p>
        <ul class="besitsol-certs__list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'feature' -%}
              <li class="besitsol-certs__list-item" {{ block.shopify_attributes }}>
                <div class="besitsol-certs__check-icon">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                </div>
                {{ block.settings.text }}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>

      <!-- Right Grid -->
      <div class="besitsol-certs__grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'badge' -%}
            <div class="besitsol-certs__badge" {{ block.shopify_attributes }}>
              <div class="besitsol-certs__badge-icon">
                {% case block.settings.icon %}
                  {% when 'leaf' %}
                    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.9C15.5 4.9 17 3.5 19 2c1 2 2 4.5 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>
                  {% when 'baby' %}
                    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12h.01"/><path d="M15 12h.01"/><path d="M10 16c.5.3 1.2.5 2 .5s1.5-.2 2-.5"/><path d="M19 6.3a9 9 0 0 1 1.8 3.9 2 2 0 0 1 0 3.6 9 9 0 0 1-17.6 0 2 2 0 0 1 0-3.6A9 9 0 0 1 12 3c2 0 3.5 1.1 3.5 2.5s-.9 2.5-2 2.5c-.8 0-1.5-.4-1.5-1"/></svg>
                  {% when 'dog' %}
                    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10 5.172C10 3.782 8.423 2.679 6.5 3c-2.823.47-4.113 6.006-4 7 .08.703 1.725 1.722 3.656 1 1.261-.472 1.96-1.45 2.344-2.5"/><path d="M14.267 5.172c0-1.39 1.577-2.493 3.5-2.172 2.823.47 4.113 6.006 4 7-.08.703-1.725 1.722-3.656 1-1.261-.472-1.855-1.45-2.239-2.5"/><path d="M8 14v.5"/><path d="M16 14v.5"/><path d="M11.25 16.25h1.5L12 17l-.75-.75Z"/><path d="M4.42 11.247A13.152 13.152 0 0 0 4 14.556C4 18.728 7.582 21 12 21s8-2.272 8-6.444c0-1.061-.162-2.2-.493-3.309m-9.243-6.082A8.801 8.801 0 0 1 12 5c.78 0 1.5.108 2.161.306"/></svg>
                  {% when 'globe' %}
                    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                  {% else %}
                    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/></svg>
                {% endcase %}
              </div>
              <h4 class="besitsol-certs__badge-title">{{ block.settings.title }}</h4>
              <p class="besitsol-certs__badge-desc">{{ block.settings.subtitle }}</p>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "BESITSOL Certifications",
  "tag": "div",
  "class": "besitsol-certs-wrapper",
  "settings": [
    {
      "type": "html",
      "id": "heading",
      "label": "Heading",
      "default": "Safe for Your Family.<br>Kind to the Planet."
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Every BESITSOL awning undergoes rigorous testing. We design with your family's health and our environmental footprint in mind."
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Item",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Feature Text",
          "default": "100% Eco-Friendly Manufacturing Process"
        }
      ]
    },
    {
      "type": "badge",
      "name": "Badge Card",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "leaf", "label": "Leaf / Eco" },
            { "value": "baby", "label": "Baby / Child Safe" },
            { "value": "dog", "label": "Dog / Pet" },
            { "value": "globe", "label": "Globe / Global" }
          ],
          "default": "leaf"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Badge Title",
          "default": "Eco-Certified"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Badge Subtitle",
          "default": "Sustainable Sourcing"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "BESITSOL Certifications",
      "blocks": [
        { "type": "feature", "settings": { "text": "100% Eco-Friendly Manufacturing Process" } },
        { "type": "feature", "settings": { "text": "Child & Pet Friendly (Non-Toxic, No Pinch Points)" } },
        { "type": "feature", "settings": { "text": "Global Safety Certifications (CE, ISO 9001)" } },
        { "type": "badge", "settings": { "icon": "leaf", "title": "Eco-Certified", "subtitle": "Sustainable Sourcing" } },
        { "type": "badge", "settings": { "icon": "baby", "title": "Child Safe", "subtitle": "Zero Hazard Mechanics" } },
        { "type": "badge", "settings": { "icon": "dog", "title": "Pet Friendly", "subtitle": "Non-Toxic Treatments" } },
        { "type": "badge", "settings": { "icon": "globe", "title": "CE / ISO", "subtitle": "Global Standards" } }
      ]
    }
  ]
}
{% endschema %}
