{% comment %}
  BESITSOL Fullpage Hero Section - 终极优化版 v2.0
  全面修复 + Shopify Online Store 2.0 完全兼容
  
  修复清单：
  1. 消除重复 const scrollContainer JS 崩溃
  2. color_extract 替代 color_to_rgb 修复 rgba() 无效 CSS
  3. inline_richtext 替代 richtext 避免嵌套 <h1>
  4. 移除不存在的 asset_url fallback 避免 404
  5. IntersectionObserver 限制滚动劫持范围
  6. CSS 自定义属性 --besitsol-vh 修复移动端 100vh
  7. loader 隐藏逻辑统一（CSS + JS 兜底）
  8. translateY 使用 --besitsol-vh 与 section 高度保持一致
  9. scene JSON 数据安全转义 </ 防止 XSS
  10. 场景描述统一 innerHTML 渲染避免 <br> 字面量
  11. 桌面端隐藏移动导航 display:none
  12. FAQ 显式写避免 sec[dynamic_key] 兼容问题
  13. section:unload 清理事件监听器
  14. noscript 兜底 + newsletter 表单成功状态
  15. url 类型 schema 不设 default 避免 Shopify 报错
  16. 所有 ID 带 section.id 防止多实例冲突
{% endcomment %}

{%- liquid
  assign sec = section.settings

  assign forest_r = sec.forest_color | color_extract: 'red'
  assign forest_g = sec.forest_color | color_extract: 'green'
  assign forest_b = sec.forest_color | color_extract: 'blue'

  assign cream_r = sec.cream_color | color_extract: 'red'
  assign cream_g = sec.cream_color | color_extract: 'green'
  assign cream_b = sec.cream_color | color_extract: 'blue'

  assign brown_r = sec.dark_brown_color | color_extract: 'red'
  assign brown_g = sec.dark_brown_color | color_extract: 'green'
  assign brown_b = sec.dark_brown_color | color_extract: 'blue'
-%}

<style>
  /* ===== 作用域限定：所有样式限制在本 section 内 ===== */
  #shopify-section-{{ section.id }} {
    --besitsol-vh: 1vh;
    --besitsol-green: {{ sec.primary_green_color }};
    --besitsol-forest: {{ sec.forest_color }};
    --besitsol-cream: {{ sec.cream_color }};
    --besitsol-brown: {{ sec.dark_brown_color }};
    --besitsol-gray: {{ sec.premium_gray_color }};
    font-family: 'Source Sans 3', sans-serif;
    color: var(--besitsol-brown);
    line-height: 1.5;
  }
  #shopify-section-{{ section.id }} * { box-sizing: border-box; margin: 0; padding: 0; }
  #shopify-section-{{ section.id }} h1,
  #shopify-section-{{ section.id }} h2,
  #shopify-section-{{ section.id }} h3,
  #shopify-section-{{ section.id }} h4 {
    font-family: 'Montserrat', sans-serif;
    line-height: 1.2;
  }

  /* 全屏滚动容器 */
  .besitsol-scroll-wrap {
    width: 100%;
    transition: transform 1.2s cubic-bezier(0.645, 0.045, 0.355, 1);
    will-change: transform;
  }
  #shopify-section-{{ section.id }}.besitsol-fullpage-active .besitsol-scroll-wrap {
    height: calc(var(--besitsol-vh, 1vh) * 100);
    overflow: hidden;
  }
  .besitsol-panel {
    height: calc(var(--besitsol-vh, 1vh) * 100);
    width: 100%;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  /* 背景层 */
  .besitsol-banner-layer {
    position: absolute; top: 0; left: 0; width: 100%; height: 100%;
    background-size: cover; background-position: center;
    background-color: var(--besitsol-forest);
    opacity: 0; transition: opacity 1.5s ease-in-out; z-index: 1;
  }
  .besitsol-banner-layer.is-active { opacity: 1; z-index: 2; }

  .besitsol-hero-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to right,
      rgba({{ forest_r }}, {{ forest_g }}, {{ forest_b }}, 0.85) 0%,
      rgba({{ forest_r }}, {{ forest_g }}, {{ forest_b }}, 0.30) 50%,
      transparent 100%);
    z-index: 3;
  }

  /* 导航 */
  .besitsol-header {
    position: relative; z-index: 10;
    display: flex; justify-content: space-between; align-items: center;
    padding: 2rem 5%; width: 100%;
  }
  .besitsol-logo {
    font-family: 'Montserrat', sans-serif;
    font-size: 1.8rem; font-weight: 700; letter-spacing: 0.2em;
    color: var(--besitsol-cream);
  }
  .besitsol-logo span { color: var(--besitsol-green); }

  /* 桌面导航 */
  .besitsol-desktop-nav { display: none; align-items: center; gap: 2rem; }
  .besitsol-nav-links { display: flex; gap: 2.5rem; font-size: 0.85rem; font-weight: 600; letter-spacing: 0.1em; list-style: none; }
  .besitsol-nav-link {
    color: var(--besitsol-cream); text-decoration: none;
    position: relative; transition: color 0.3s ease;
  }
  .besitsol-nav-link::after {
    content: ''; position: absolute; bottom: -4px; left: 0; width: 0; height: 2px;
    background-color: var(--besitsol-green); transition: width 0.3s ease;
  }
  .besitsol-nav-link:hover { color: var(--besitsol-green); }
  .besitsol-nav-link:hover::after { width: 100%; }

  .besitsol-shop-btn {
    padding: 0.7rem 1.5rem; border-radius: 50px;
    font-size: 0.75rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
    background-color: var(--besitsol-cream); color: var(--besitsol-forest);
    border: none; cursor: pointer;
    display: inline-flex; align-items: center; gap: 0.5rem;
    transition: background-color 0.3s ease, color 0.3s ease;
    text-decoration: none;
  }
  .besitsol-shop-btn:hover { background-color: var(--besitsol-green); color: var(--besitsol-cream); }

  /* 移动端菜单按钮 */
  .besitsol-mobile-menu-btn {
    display: inline-flex; align-items: center;
    background: transparent; border: none; cursor: pointer;
    color: var(--besitsol-cream); padding: 0.5rem;
  }

  /* 移动端导航面板 */
  .besitsol-mobile-nav {
    position: fixed; top: 0; right: 0; height: 100dvh; width: 80%; max-width: 300px;
    background-color: var(--besitsol-forest); z-index: 1000;
    padding: 4rem 2rem 2rem; display: flex; flex-direction: column; gap: 1.5rem;
    transform: translateX(100%); visibility: hidden;
    transition: transform 0.3s ease-in-out, visibility 0s 0.3s;
  }
  .besitsol-mobile-nav.is-open { transform: translateX(0); visibility: visible; transition: transform 0.3s ease-in-out, visibility 0s 0s; }
  .besitsol-mobile-nav-link {
    color: var(--besitsol-cream); text-decoration: none;
    font-size: 1rem; font-weight: 600; letter-spacing: 0.1em;
    padding: 0.75rem 0; border-bottom: 1px solid rgba({{ cream_r }}, {{ cream_g }}, {{ cream_b }}, 0.1);
  }
  .besitsol-close-menu {
    position: absolute; top: 1.5rem; right: 1.5rem;
    background: transparent; border: none; cursor: pointer;
    color: var(--besitsol-cream); padding: 0.5rem;
  }
  .besitsol-mobile-overlay {
    position: fixed; inset: 0; z-index: 999;
    background: rgba(0,0,0,0.5); opacity: 0; visibility: hidden;
    transition: opacity 0.3s ease, visibility 0s 0.3s;
  }
  .besitsol-mobile-overlay.is-open { opacity: 1; visibility: visible; transition: opacity 0.3s ease, visibility 0s 0s; }

  /* 英雄内容 */
  .besitsol-hero-content {
    position: relative; z-index: 10;
    flex: 1; display: flex; flex-direction: column; justify-content: space-between;
    padding: 0 5% 3rem;
  }
  .besitsol-hero-text { max-width: 600px; margin-top: 2rem; }
  .besitsol-hero-tag {
    display: inline-block; padding: 0.5rem 1rem; margin-bottom: 1.5rem;
    border: 1px solid rgba({{ cream_r }}, {{ cream_g }}, {{ cream_b }}, 0.3);
    border-radius: 50px; font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--besitsol-cream);
  }
  .besitsol-hero-title {
    font-size: 2.5rem; font-weight: 700;
    line-height: 1.2; margin-bottom: 1.5rem; color: var(--besitsol-cream);
  }
  .besitsol-hero-desc {
    font-size: 1rem; line-height: 1.6; margin-bottom: 2rem;
    color: var(--besitsol-cream); opacity: 0.9; max-width: 400px;
  }
  .besitsol-hero-btn {
    padding: 1rem 2rem; border-radius: 50px;
    font-size: 0.9rem; font-weight: 600; letter-spacing: 0.1em;
    background-color: var(--besitsol-green); color: var(--besitsol-cream);
    border: none; cursor: pointer;
    display: inline-flex; align-items: center; gap: 0.8rem;
    transition: background-color 0.3s ease;
    text-decoration: none;
  }
  .besitsol-hero-btn:hover { background-color: var(--besitsol-forest); }

  /* 场景切换 */
  .besitsol-scene-buttons { margin-top: 2rem; }
  .besitsol-scene-label {
    font-size: 0.7rem; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--besitsol-cream); opacity: 0.5; margin-bottom: 1rem;
  }
  .besitsol-scene-btn {
    display: block; width: 100%; text-align: left;
    background: transparent; border: none; border-left: 3px solid transparent;
    cursor: pointer; font-family: 'Montserrat', sans-serif;
    font-size: 1.1rem; letter-spacing: 0.05em;
    color: var(--besitsol-cream); margin-bottom: 1rem;
    padding: 0.5rem 0 0.5rem 0; position: relative;
    transition: all 0.3s ease; opacity: 0.6;
  }
  .besitsol-scene-btn.is-active {
    padding-left: 1rem; border-left-color: var(--besitsol-green); opacity: 1;
  }
  .besitsol-scene-btn:not(.is-active):hover { opacity: 1; padding-left: 0.5rem; }

  /* Loader */
  .besitsol-loader {
    position: fixed; inset: 0; z-index: 9999;
    background-color: var(--besitsol-forest);
    display: flex; flex-direction: column; justify-content: center; align-items: center;
    color: var(--besitsol-cream);
    transition: opacity 0.6s ease, visibility 0.6s ease;
  }
  .besitsol-loader.is-hidden { opacity: 0; visibility: hidden; pointer-events: none; }
  .besitsol-spinner {
    width: 50px; height: 50px;
    border: 3px solid rgba({{ cream_r }}, {{ cream_g }}, {{ cream_b }}, 0.3);
    border-radius: 50%; border-top-color: var(--besitsol-green);
    animation: besitsol-spin 1s ease-in-out infinite;
    margin-bottom: 1.5rem;
  }
  @keyframes besitsol-spin { to { transform: rotate(360deg); } }
  .besitsol-loader-text { font-family: 'Montserrat', sans-serif; font-size: 1.2rem; letter-spacing: 0.2em; margin-bottom: 0.5rem; }
  .besitsol-loader-subtext { font-size: 0.8rem; opacity: 0.7; letter-spacing: 0.1em; }

  /* 通用模块 */
  .besitsol-module { padding: 4rem 5%; height: 100%; display: flex; flex-direction: column; justify-content: center; }
  .besitsol-module--forest { background-color: var(--besitsol-forest); color: var(--besitsol-cream); }
  .besitsol-module--brown  { background-color: var(--besitsol-brown); color: var(--besitsol-cream); }
  .besitsol-module--cream  { background-color: var(--besitsol-cream); color: var(--besitsol-brown); }
  .besitsol-module-header { text-align: center; margin-bottom: 3rem; }
  .besitsol-module-tag { font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--besitsol-green); margin-bottom: 1rem; display: block; }
  .besitsol-module-title { font-size: 2rem; font-weight: 700; margin-bottom: 1rem; }
  .besitsol-module-divider { width: 50px; height: 2px; background-color: var(--besitsol-green); margin: 0 auto; }
  .besitsol-module-desc { font-size: 0.95rem; line-height: 1.6; opacity: 0.85; max-width: 700px; margin: 1.5rem auto 0; }

  .besitsol-grid { display: grid; grid-template-columns: 1fr; gap: 2rem; }
  .besitsol-card {
    padding: 2rem; border-radius: 1rem;
    background: rgba({{ cream_r }}, {{ cream_g }}, {{ cream_b }}, 0.92);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: var(--besitsol-brown);
  }
  .besitsol-card--dark {
    background: transparent;
    border: 1px solid rgba({{ cream_r }}, {{ cream_g }}, {{ cream_b }}, 0.12);
    color: var(--besitsol-cream);
  }
  .besitsol-card-icon { color: var(--besitsol-green); margin-bottom: 1rem; font-size: 1.5rem; }
  .besitsol-card-title { font-size: 1.2rem; font-weight: 700; margin-bottom: 1rem; }
  .besitsol-card-desc { font-size: 0.9rem; line-height: 1.6; opacity: 0.85; }

  /* 技术规格 */
  .besitsol-tech-list { list-style: disc; padding-left: 1.5rem; font-size: 0.9rem; color: var(--besitsol-gray); margin-top: 1rem; }
  .besitsol-tech-list li { margin-bottom: 0.5rem; }

  /* FAQ */
  .besitsol-faq-container { max-width: 800px; margin: 0 auto; width: 100%; }
  .besitsol-faq-item { border-bottom: 1px solid rgba({{ brown_r }}, {{ brown_g }}, {{ brown_b }}, 0.1); padding: 1rem 0; }
  .besitsol-faq-question {
    display: flex; justify-content: space-between; align-items: center;
    width: 100%; background: transparent; border: none; cursor: pointer;
    font-family: 'Montserrat', sans-serif; font-size: 1rem; font-weight: 600;
    color: var(--besitsol-brown); padding: 0.5rem 0; text-align: left; gap: 1rem;
  }
  .besitsol-faq-question:hover { color: var(--besitsol-green); }
  .besitsol-faq-icon { color: var(--besitsol-green); transition: transform 0.3s ease; flex-shrink: 0; }
  .besitsol-faq-answer {
    max-height: 0; overflow: hidden; transition: max-height 0.5s ease, padding 0.3s ease;
    font-size: 0.9rem; line-height: 1.6; color: var(--besitsol-gray); padding: 0;
  }
  .besitsol-faq-item.is-open .besitsol-faq-answer { max-height: 500px; padding: 0.75rem 0 1rem; }
  .besitsol-faq-item.is-open .besitsol-faq-icon { transform: rotate(180deg); }

  /* 页脚 */
  .besitsol-footer { padding: 3rem 5%; }
  .besitsol-footer-grid { display: grid; grid-template-columns: 1fr; gap: 2rem; }
  .besitsol-footer-col { margin-bottom: 1.5rem; }
  .besitsol-footer-logo { font-family: 'Montserrat', sans-serif; font-size: 1.5rem; font-weight: 700; letter-spacing: 0.2em; margin-bottom: 1rem; color: var(--besitsol-cream); }
  .besitsol-footer-desc { font-size: 0.9rem; line-height: 1.6; opacity: 0.7; max-width: 300px; margin-bottom: 1.5rem; color: var(--besitsol-cream); }
  .besitsol-social-links { display: flex; gap: 1rem; }
  .besitsol-social-link { color: var(--besitsol-cream); opacity: 0.7; transition: opacity 0.3s ease, color 0.3s ease; }
  .besitsol-social-link:hover { opacity: 1; color: var(--besitsol-green); }
  .besitsol-footer-heading { font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase; font-weight: 600; margin-bottom: 1rem; color: var(--besitsol-cream); }
  .besitsol-footer-links { list-style: none; }
  .besitsol-footer-link { margin-bottom: 0.8rem; }
  .besitsol-footer-link a { color: var(--besitsol-cream); opacity: 0.7; text-decoration: none; font-size: 0.9rem; transition: opacity 0.3s ease, color 0.3s ease; }
  .besitsol-footer-link a:hover { opacity: 1; color: var(--besitsol-green); }
  .besitsol-subscribe-form { display: flex; margin-top: 1rem; }
  .besitsol-subscribe-input {
    flex: 1; padding: 0.8rem 1rem;
    background: rgba({{ cream_r }}, {{ cream_g }}, {{ cream_b }}, 0.1);
    border: none; border-radius: 50px 0 0 50px;
    color: var(--besitsol-cream); font-size: 0.9rem; outline: none;
  }
  .besitsol-subscribe-input::placeholder { color: rgba({{ cream_r }}, {{ cream_g }}, {{ cream_b }}, 0.5); }
  .besitsol-subscribe-input:focus { background: rgba({{ cream_r }}, {{ cream_g }}, {{ cream_b }}, 0.18); }
  .besitsol-subscribe-btn {
    padding: 0.8rem 1.2rem;
    background-color: var(--besitsol-green); color: var(--besitsol-cream);
    border: none; border-radius: 0 50px 50px 0;
    cursor: pointer; transition: background-color 0.3s ease;
  }
  .besitsol-subscribe-btn:hover { background-color: var(--besitsol-forest); }
  .besitsol-footer-bottom {
    padding-top: 2rem; margin-top: 2rem;
    border-top: 1px solid rgba({{ cream_r }}, {{ cream_g }}, {{ cream_b }}, 0.1);
    font-size: 0.8rem; opacity: 0.5; text-align: center; color: var(--besitsol-cream);
  }
  .besitsol-footer-bottom-links { display: flex; gap: 1.5rem; justify-content: center; margin-top: 1rem; flex-wrap: wrap; }
  .besitsol-footer-bottom-links a { color: var(--besitsol-cream); text-decoration: none; }

  /* 响应式 */
  @media (min-width: 768px) {
    .besitsol-desktop-nav { display: flex; }
    .besitsol-mobile-menu-btn { display: none; }
    .besitsol-hero-content { flex-direction: row; align-items: flex-end; padding: 0 5% 4rem; }
    .besitsol-hero-text { margin-top: 0; }
    .besitsol-hero-title { font-size: 3.5rem; }
    .besitsol-scene-buttons { margin-top: 0; margin-left: 4rem; width: 300px; }
    .besitsol-grid { grid-template-columns: repeat(3, 1fr); }
    .besitsol-grid.besitsol-grid--2col { grid-template-columns: repeat(2, 1fr); }
    .besitsol-footer-grid { grid-template-columns: 2fr 1fr 1fr; }
    .besitsol-module-title { font-size: 2.5rem; }
  }
  @media (min-width: 1200px) {
    .besitsol-header, .besitsol-module, .besitsol-footer { padding-left: 10%; padding-right: 10%; }
    .besitsol-hero-title { font-size: 4rem; }
  }

  /* Theme Editor 模式：禁用滚动劫持 */
  .shopify-design-mode #shopify-section-{{ section.id }}.besitsol-fullpage-active .besitsol-scroll-wrap {
    height: auto; overflow: visible; transform: none !important;
  }
  .shopify-design-mode #shopify-section-{{ section.id }} .besitsol-panel {
    height: auto; min-height: 100vh;
  }
  .shopify-design-mode #shopify-section-{{ section.id }} .besitsol-loader { display: none; }

  /* SVG 图标 */
  .besitsol-icon {
    width: 1em; height: 1em; stroke: currentColor;
    stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; fill: none;
    display: inline-block; vertical-align: middle;
  }
</style>


{%- comment -%} ========== LOADER ========== {%- endcomment -%}
<div class="besitsol-loader" data-besitsol-loader aria-hidden="true">
  <div class="besitsol-spinner"></div>
  <h2 class="besitsol-loader-text">BESITSOL</h2>
  <p class="besitsol-loader-subtext">Rendering your exclusive lifestyle scenes...</p>
</div>

<noscript>
  <style>.besitsol-loader { display: none !important; }</style>
</noscript>

{%- comment -%} ========== 主滚动容器 ========== {%- endcomment -%}
<div class="besitsol-scroll-wrap" data-besitsol-scroll>

  {%- comment -%} ===== PANEL 0: HERO ===== {%- endcomment -%}
  <section class="besitsol-panel" data-panel="0">
    {%- if sec.scene1_bg_image != blank -%}
      <div class="besitsol-banner-layer is-active" data-scene="scene1" style="background-image: url('{{ sec.scene1_bg_image | image_url: width: 1920 }}');"></div>
    {%- else -%}
      <div class="besitsol-banner-layer is-active" data-scene="scene1"></div>
    {%- endif -%}

    {%- if sec.scene2_bg_image != blank -%}
      <div class="besitsol-banner-layer" data-scene="scene2" style="background-image: url('{{ sec.scene2_bg_image | image_url: width: 1920 }}');"></div>
    {%- else -%}
      <div class="besitsol-banner-layer" data-scene="scene2"></div>
    {%- endif -%}

    {%- if sec.scene3_bg_image != blank -%}
      <div class="besitsol-banner-layer" data-scene="scene3" style="background-image: url('{{ sec.scene3_bg_image | image_url: width: 1920 }}');"></div>
    {%- else -%}
      <div class="besitsol-banner-layer" data-scene="scene3"></div>
    {%- endif -%}

    <div class="besitsol-hero-overlay"></div>

    <!-- 顶部导航 -->
    <header class="besitsol-header">
      <div class="besitsol-logo">BESITSOL<span>.</span></div>

      <div class="besitsol-desktop-nav">
        <nav class="besitsol-nav-links" aria-label="Main navigation">
          <a href="{{ sec.nav_link_1_url | default: '#' }}" class="besitsol-nav-link" data-goto="1">{{ sec.nav_link_1_text }}</a>
          <a href="{{ sec.nav_link_2_url | default: '#' }}" class="besitsol-nav-link" data-goto="2">{{ sec.nav_link_2_text }}</a>
          <a href="{{ sec.nav_link_3_url | default: '#' }}" class="besitsol-nav-link" data-goto="3">{{ sec.nav_link_3_text }}</a>
          <a href="{{ sec.nav_link_4_url | default: '#' }}" class="besitsol-nav-link" data-goto="5">{{ sec.nav_link_4_text }}</a>
        </nav>
        <a class="besitsol-shop-btn" href="{{ sec.shop_now_link | default: '/collections/all' }}">
          <svg class="besitsol-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
          {{ sec.shop_now_text }}
        </a>
      </div>

      <button type="button" class="besitsol-mobile-menu-btn" data-mobile-toggle aria-label="Open navigation menu" aria-expanded="false">
        <svg class="besitsol-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24"><line x1="4" x2="20" y1="12" y2="12"></line><line x1="4" x2="20" y1="6" y2="6"></line><line x1="4" x2="20" y1="18" y2="18"></line></svg>
      </button>
    </header>

