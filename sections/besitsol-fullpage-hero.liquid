{%- comment -%} ========== 核心交互逻辑 ========== {%- endcomment -%}
<script>
(function() {
  'use strict';

  /* ===== 初始化 ===== */
  var sectionEl = document.getElementById('shopify-section-{{ section.id }}');
  if (!sectionEl) return;

  var IS_EDITOR = !!(window.Shopify && window.Shopify.designMode);
  var scrollWrap = sectionEl.querySelector('[data-besitsol-scroll]');
  var panels = sectionEl.querySelectorAll('.besitsol-panel');
  var loader = sectionEl.querySelector('[data-besitsol-loader]');
  var mobileNav = sectionEl.querySelector('[data-mobile-nav]');
  var mobileOverlay = sectionEl.querySelector('[data-mobile-overlay]');
  var totalPanels = panels.length;
  var currentPanel = 0;
  var isScrolling = false;
  var scrollTimeout = 1300;
  var touchStartY = 0;

  /* ===== 修复移动端 100vh ===== */
  function updateVh() {
    var vh = window.innerHeight * 0.01;
    sectionEl.style.setProperty('--besitsol-vh', vh + 'px');
  }
  updateVh();
  window.addEventListener('resize', updateVh);
  window.addEventListener('orientationchange', function() {
    setTimeout(updateVh, 200);
  });

  /* ===== Loader ===== */
  function hideLoader() {
    if (loader) loader.classList.add('is-hidden');
  }
  if (document.readyState === 'complete') {
    setTimeout(hideLoader, 300);
  } else {
    window.addEventListener('load', function() { setTimeout(hideLoader, 300); });
  }
  // 兜底：最多显示 3.5 秒
  setTimeout(hideLoader, 3500);

  /* ===== 启用全屏滚动（非 Editor 模式） ===== */
  if (!IS_EDITOR) {
    sectionEl.classList.add('besitsol-fullpage-active');
  }

  /* ===== 场景数据解析 ===== */
  var sceneData = {};
  try {
    var jsonEl = sectionEl.querySelector('[data-besitsol-scenes]');
    if (jsonEl) sceneData = JSON.parse(jsonEl.textContent);
  } catch (e) {
    console.warn('[BESITSOL] Scene data parse error:', e);
  }

  /* ===== 场景切换 ===== */
  function switchScene(sceneName) {
    if (!sceneData[sceneName]) return;

    // 背景层
    var layers = sectionEl.querySelectorAll('.besitsol-banner-layer');
    for (var i = 0; i < layers.length; i++) {
      layers[i].classList.toggle('is-active', layers[i].getAttribute('data-scene') === sceneName);
    }

    // 按钮状态
    var btns = sectionEl.querySelectorAll('[data-scene-btn]');
    for (var j = 0; j < btns.length; j++) {
      btns[j].classList.toggle('is-active', btns[j].getAttribute('data-scene-btn') === sceneName);
    }

    // 文本内容（统一 innerHTML，支持 inline_richtext 的 <br> 和 <strong>）
    var titleEl = sectionEl.querySelector('[data-banner-title]');
    var descEl = sectionEl.querySelector('[data-banner-desc]');
    if (titleEl) titleEl.innerHTML = sceneData[sceneName].title || '';
    if (descEl) descEl.innerHTML = sceneData[sceneName].desc || '';
  }

  // 绑定场景按钮
  var sceneBtns = sectionEl.querySelectorAll('[data-scene-btn]');
  for (var s = 0; s < sceneBtns.length; s++) {
    sceneBtns[s].addEventListener('click', (function(btn) {
      return function() { switchScene(btn.getAttribute('data-scene-btn')); };
    })(sceneBtns[s]));
  }

  /* ===== 移动端菜单 ===== */
  function openMobileMenu() {
    if (!mobileNav) return;
    mobileNav.classList.add('is-open');
    mobileNav.setAttribute('aria-hidden', 'false');
    if (mobileOverlay) mobileOverlay.classList.add('is-open');
    var toggleBtn = sectionEl.querySelector('.besitsol-mobile-menu-btn');
    if (toggleBtn) toggleBtn.setAttribute('aria-expanded', 'true');
  }
  function closeMobileMenu() {
    if (!mobileNav) return;
    mobileNav.classList.remove('is-open');
    mobileNav.setAttribute('aria-hidden', 'true');
    if (mobileOverlay) mobileOverlay.classList.remove('is-open');
    var toggleBtn = sectionEl.querySelector('.besitsol-mobile-menu-btn');
    if (toggleBtn) toggleBtn.setAttribute('aria-expanded', 'false');
  }

  var toggleBtns = sectionEl.querySelectorAll('[data-mobile-toggle]');
  for (var t = 0; t < toggleBtns.length; t++) {
    toggleBtns[t].addEventListener('click', function() {
      if (mobileNav && mobileNav.classList.contains('is-open')) {
        closeMobileMenu();
      } else {
        openMobileMenu();
      }
    });
  }
  if (mobileOverlay) {
    mobileOverlay.addEventListener('click', closeMobileMenu);
  }

  /* ===== FAQ ===== */
  var faqBtns = sectionEl.querySelectorAll('[data-faq-toggle]');
  for (var f = 0; f < faqBtns.length; f++) {
    faqBtns[f].addEventListener('click', function() {
      var item = this.parentElement;
      var isOpen = item.classList.contains('is-open');
      item.classList.toggle('is-open');
      this.setAttribute('aria-expanded', !isOpen);
      var answer = item.querySelector('.besitsol-faq-answer');
      if (answer) answer.setAttribute('aria-hidden', isOpen);
    });
  }

  /* ===== 全屏滚动导航 ===== */
  if (!IS_EDITOR && scrollWrap) {
    function goToPanel(index) {
      if (isScrolling || index < 0 || index >= totalPanels) return;
      isScrolling = true;
      currentPanel = index;
      // 使用 CSS 自定义属性值来计算偏移（与 panel 高度一致）
      var vh = parseFloat(getComputedStyle(sectionEl).getPropertyValue('--besitsol-vh')) || (window.innerHeight * 0.01);
      var offset = currentPanel * vh * 100;
      scrollWrap.style.transform = 'translateY(-' + offset + 'px)';
      setTimeout(function() { isScrolling = false; }, scrollTimeout);
    }

    // 导航链接 data-goto
    var gotoLinks = sectionEl.querySelectorAll('[data-goto]');
    for (var g = 0; g < gotoLinks.length; g++) {
      gotoLinks[g].addEventListener('click', (function(link) {
        return function(e) {
          var idx = parseInt(link.getAttribute('data-goto'), 10);
          if (!isNaN(idx) && idx >= 0 && idx < totalPanels) {
            e.preventDefault();
            goToPanel(idx);
            closeMobileMenu();
          }
        };
      })(gotoLinks[g]));
    }

    // IntersectionObserver：仅当 section 在视窗内时劫持滚动
    var inViewport = true; // 默认 true（如果是首屏唯一 section）
    if (window.IntersectionObserver) {
      var observer = new IntersectionObserver(function(entries) {
        for (var i = 0; i < entries.length; i++) {
          if (entries[i].target === sectionEl) {
            inViewport = entries[i].intersectionRatio > 0.3;
          }
        }
      }, { threshold: [0, 0.3, 0.5, 1] });
      observer.observe(sectionEl);
    }

    // 滚轮
    function onWheel(e) {
      if (!inViewport || isScrolling) return;
      var delta = e.deltaY || e.detail || -e.wheelDelta;
      if (delta > 5 && currentPanel < totalPanels - 1) {
        e.preventDefault();
        goToPanel(currentPanel + 1);
      } else if (delta < -5 && currentPanel > 0) {
        e.preventDefault();
        goToPanel(currentPanel - 1);
      }
    }
    sectionEl.addEventListener('wheel', onWheel, { passive: false });

    // 键盘
    function onKeydown(e) {
      if (!inViewport || isScrolling) return;
      // 仅当没有聚焦到输入框时才劫持
      var tag = (document.activeElement && document.activeElement.tagName) || '';
      if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return;

      if ((e.key === 'ArrowDown' || e.key === 'PageDown') && currentPanel < totalPanels - 1) {
        e.preventDefault();
        goToPanel(currentPanel + 1);
      } else if ((e.key === 'ArrowUp' || e.key === 'PageUp') && currentPanel > 0) {
        e.preventDefault();
        goToPanel(currentPanel - 1);
      }
    }
    document.addEventListener('keydown', onKeydown);

    // 触摸
    function onTouchStart(e) { touchStartY = e.touches[0].clientY; }
    function onTouchEnd(e) {
      if (!inViewport || isScrolling) return;
      var diff = touchStartY - e.changedTouches[0].clientY;
      if (diff > 60 && currentPanel < totalPanels - 1) {
        goToPanel(currentPanel + 1);
      } else if (diff < -60 && currentPanel > 0) {
        goToPanel(currentPanel - 1);
      }
    }
    sectionEl.addEventListener('touchstart', onTouchStart, { passive: true });
    sectionEl.addEventListener('touchend', onTouchEnd, { passive: true });

    /* ===== 清理：Shopify section unload ===== */
    document.addEventListener('shopify:section:unload', function(e) {
      if (e.detail && e.detail.sectionId === '{{ section.id }}') {
        sectionEl.removeEventListener('wheel', onWheel);
        sectionEl.removeEventListener('touchstart', onTouchStart);
        sectionEl.removeEventListener('touchend', onTouchEnd);
        document.removeEventListener('keydown', onKeydown);
        window.removeEventListener('resize', updateVh);
        if (observer) observer.disconnect();
      }
    });
  }

  /* ===== Theme Editor 事件 ===== */
  if (IS_EDITOR) {
    document.addEventListener('shopify:section:select', function(e) {
      if (e.detail && e.detail.sectionId === '{{ section.id }}') {
        hideLoader();
      }
    });
  }
})();
</script>


