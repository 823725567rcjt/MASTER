{% comment %}
  BESITSOL Materials Section — 材料展示
{% endcomment %}

<section id="s-materials" class="besitsol-section besitsol-materials">
  <div class="besitsol-container">
    <div class="besitsol-materials__header">
      <span class="besitsol-materials__eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 class="besitsol-heading">{{ section.settings.heading }}</h2>
      <div class="besitsol-divider"></div>
    </div>

    <div class="besitsol-materials__grid">
      {%- for block in section.blocks -%}
        <div class="besitsol-materials__card" {{ block.shopify_attributes }}>
          <div class="besitsol-materials__card-icon">
            {% case block.settings.icon %}
              {% when 'layers' %}
                <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
              {% when 'box' %}
                <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>
              {% when 'link' %}
                <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
              {% else %}
                <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/></svg>
            {% endcase %}
          </div>
          <h3 class="besitsol-materials__card-title">{{ block.settings.title }}</h3>
          <p class="besitsol-materials__card-desc">{{ block.settings.description }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "BESITSOL Materials",
  "tag": "div",
  "class": "besitsol-materials-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Premium Sourcing"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "World-Class Materials"
    }
  ],
  "blocks": [
    {
      "type": "material",
      "name": "Material Card",
      "limit": 6,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "layers", "label": "Layers" },
            { "value": "box", "label": "Box" },
            { "value": "link", "label": "Link" }
          ],
          "default": "layers"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Material Name"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Material description goes here."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "BESITSOL Materials",
      "blocks": [
        {
          "type": "material",
          "settings": {
            "icon": "layers",
            "title": "RECASENS\u00ae Fabric",
            "description": "Sourced from Spain, this premium solution-dyed acrylic fabric offers unparalleled UV protection, colorfastness, and water resistance for over a decade."
          }
        },
        {
          "type": "material",
          "settings": {
            "icon": "box",
            "title": "Aero-Grade Aluminum",
            "description": "The main frame is constructed using lightweight yet incredibly robust aviation-grade aluminum alloy, guaranteeing zero rust and structural integrity."
          }
        },
        {
          "type": "material",
          "settings": {
            "icon": "link",
            "title": "Stainless Steel Hinges",
            "description": "Marine-grade 304 stainless steel connection hinges and drop-forged arm joints ensure silent, smooth, and lifetime-reliable mechanical operation."
          }
        }
      ]
    }
  ]
}
{% endschema %}
